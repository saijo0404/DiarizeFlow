{
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "chunk_ms": 250,
    "mic_device": null,
    "loopback_device": null,
    "mix_sources": true,
    "gain": 1.2,
    "agc_enabled": true,
    "agc_target_rms": 0.08,
    "agc_max_gain": 4.0,
    "agc_min_gain": 0.25
  },
  "vad": {
    "enabled": true,
    "energy_threshold": 0.008,
    "min_speech_ms": 250,
    "silence_timeout_ms": 300,
    "max_speech_s": 3.5,
    "pre_pad_ms": 150,
    "post_pad_ms": 150
  },
  "diarization": {
    "enabled": true,
    "model_path": "models/nemotron_diarization/Nemotron-3-Diarization.onnx",
    "fp16_model_path": "models/nemotron_diarization/Nemotron-3-Diarization_fp16.onnx",
    "use_fp16": true,
    "streaming_mode": "low_latency",
    "speaker_threshold": 0.82,
    "sad_threshold": 0.50,
    "max_speakers": 8
  },
  "asr": {
    "engine": "sensevoice",
    "model_dir": "models/sensevoice_small",
    "model_path": "models/sensevoice_small/SenseVoiceSmall.onnx",
    "cmvn_file": "models/sensevoice_small/am.mvn",
    "bpe_model": "models/sensevoice_small/chn_jpn_yue_eng_ko_spectok.bpe.model",
    "language": "auto",
    "use_gpu": true,
    "whisper_model": "models/faster-whisper-large-v2",
    "whisper_precision": "float16",
    "beam_size": 1
  },
  "llm": {
    "provider": "vllm",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key": "EMPTY",
    "model_name": "auto",
    "target_language": "繁體中文",
    "temperature": 0.1,
    "max_tokens": 512,
    "system_prompt": "你是一位高水準的即時語音字幕翻譯專家。請將發話內容直接翻譯成【{target_language}】。\n重要規則：\n1. 輸入文本來自即時語音辨識（ASR），可能包含語音同音錯字、非標準口語、無標點、截斷尾音或外來語音譯。\n2. 請根據整句話的語意脈絡與生活常理，自動理解真實含意並轉化為通順道地的表達，嚴禁生硬音譯無關事物。\n3. 嚴禁無中生有之過度腦補，遇到不完整或模糊的語句，以符合上下文的最簡明自然方式收尾即可。\n4. 僅輸出翻譯結果，嚴禁包含思考過程、引號、拼音或任何額外說明。"
  },
  "ui": {
    "fade_out_seconds": 5.0,
    "font_size": 22,
    "opacity": 0.5,
    "always_on_top": true,
    "click_through": false,
    "show_original": true,
    "accent_color": "#38bdf8",
    "window_width": 760,
    "window_height": 180
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "ws_endpoint": "/ws/audio",
    "subtitles_endpoint": "/ws/subtitles"
  },
  "hardware_calibrated": false
}